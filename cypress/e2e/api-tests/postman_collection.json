           { ","                            property: 'accessToken', ","                            type: 'string', ","                            notEmpty: true","                        });","","// SETTERS //","pm.environment.set(\"accessToken\", response.accessToken);","pm.collectionVariables.set(\"accessToken\", response.accessToken);","pm.collectionVariables.set('clientName', client.clientName);","pm.collectionVariables.set('clientEmail', client.clientEmail);",""],"type":"text/javascript","packages":{},"requests":{}}},{"listen":"prerequest","script":{"id":"278bd354-57f3-4361-b296-37944e6a1a10","exec":[""],"type":"text/javascript","packages":{},"requests":{}}}],"id":"c48a8cb2-8a36-4858-8b6d-122101f28bba","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"auth":{"type":"noauth"},"method":"POST","header":[],"body":{"mode":"raw","raw":"{\r\n   \"clientName\": \"{{$randomUserName}}\",\r\n   \"clientEmail\": \"{{$randomEmail}}\"\r\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/api-clients","host":["{{baseUrl}}"],"path":["api-clients"]}},"response":[],"createdAt":"2026-03-30T23:08:24.000Z","updatedAt":"2026-04-08T04:29:24.000Z","uid":"10898324-c48a8cb2-8a36-4858-8b6d-122101f28bba"},{"name":"Create Cart","event":[{"listen":"test","script":{"id":"6fb714e0-d771-4e60-9cc6-45466ada4c0d","exec":["// VARIABLES //\r","const response = pm.response.json();\r","const cartId = response.cartId;\r","\r","// ASSERTIONS //\r","assertStatusIs(201);\r","assertResponseContains(response, \r","                        { \r","                            property: 'created', \r","                            type: 'boolean', \r","                            expectedValue: true \r","                        });\r","\r","assertResponseContains(response, \r","                        { \r","                            property: 'cartId', \r","                            type: 'string',\r","                            notEmpty: true\r","                        });\r","\r","\r","// SETTERS //\r","pm.collectionVariables.set(\"cartId\", cartId);\r","pm.environment.set(\"cartId\", cartId);"],"type":"text/javascript","packages":{},"requests":{}}}],"id":"008d36d0-5724-4496-8e52-0fdf0aa9cd29","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[],"url":{"raw":"{{baseUrl}}/carts","host":["{{baseUrl}}"],"path":["carts"]}},"response":[],"createdAt":"2026-03-31T08:10:13.000Z","updatedAt":"2026-04-08T00:23:55.000Z","uid":"10898324-008d36d0-5724-4496-8e52-0fdf0aa9cd29"},{"name":"Add to Cart","event":[{"listen":"test","script":{"id":"9b984c3a-52cd-4526-99d6-bfc7a93f93d5","exec":["// VARIABLES //\r","const response=pm.response.json();\r","const itemId=response.itemId;\r","\r","// ASSERTIONS //\r","assertStatusIs(201);\r","assertResponseContains(response, \r","                        { \r","                            property: 'created', \r","                            type: 'boolean', \r","                            expectedValue: true \r","                        });\r","assertResponseContains(response, \r","                        { \r","                            property: 'itemId', \r","                            type: 'number', \r","                            notNull: true\r","                        });\r","\r","// SETTERS //\r","pm.collectionVariables.set('itemId',itemId)"],"type":"text/javascript","packages":{},"requests":{}}},{"listen":"prerequest","script":{"id":"f9ea742f-1235-46bc-b721-1ddd2cff6659","exec":[""],"type":"text/javascript","packages":{},"requests":{}}}],"id":"fe778733-7bd1-491c-af06-4497eab0a50b","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\r\n    \"productId\": {{productId}},\r\n    \"quantity\": 1\r\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/carts/:cartId/items","host":["{{baseUrl}}"],"path":["carts",":cartId","items"],"variable":[{"key":"cartId","value":"{{cartId}}"}]}},"response":[],"createdAt":"2026-03-31T09:47:54.000Z","updatedAt":"2026-04-13T11:54:12.000Z","uid":"10898324-fe778733-7bd1-491c-af06-4497eab0a50b"},{"name":"Create Order","event":[{"listen":"prerequest","script":{"id":"bf82be0a-4210-411e-b7e0-66fd99dfba83","exec":[""],"type":"text/javascript","packages":{},"requests":{}}},{"listen":"test","script":{"id":"f74271a6-50b6-4b20-83e4-598f0c538007","exec":["// VARIABLES //","const response = pm.response.json();","const orderId = response.orderId;","const customer = JSON.parse(pm.request.body.raw);","","// ASSERTIONS //","assertStatusIs(201);","assertResponseContains(response, ","                        { ","                            property: 'created', ","                            type: 'boolean', ","                            expectedValue: true","                        });","assertResponseContains(response, ","                        { ","                            property: 'orderId', ","                            type: 'string', ","                            notEmpty: true","                        });                        ","","// SETTERS //","pm.collectionVariables.set(\"orderId\", orderId);","pm.collectionVariables.set('customerName', customer.customerName);","","// CLEANUP - ENVIRONMENT AND COLLECTION VARIABLES //","const keep = [\"baseUrl\"];","","Object.keys(pm.environment.toObject()).forEach(keys => {","    if(!keep.includes(keys)) {","        pm.environment.unset(keys);","    }","});","","Object.keys(pm.collectionVariables.toObject()).forEach(keys => {","    if(!keep.includes(keys)) {","        pm.collectionVariables.unset(keys);","    }","});","",""],"type":"text/javascript","packages":{},"requests":{}}}],"id":"c78002ef-9079-44e8-9cda-e7df293cdb17","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{accessToken}}","type":"text"}],"body":{"mode":"raw","raw":"{\r\n    \"cartId\": \"{{cartId}}\",\r\n    \"customerName\": \"{{$randomFullName}}\"\r\n}","options":{"raw":{"language":"json"}}},"url":{"raw":"{{baseUrl}}/orders","host":["{{baseUrl}}"],"path":["orders"]}},"response":[],"createdAt":"2026-03-30T23:34:58.000Z","updatedAt":"2026-04-08T04:29:05.000Z","uid":"10898324-c78002ef-9079-44e8-9cda-e7df293cdb17"}],"event":[{"listen":"prerequest","script":{"id":"3efa3465-2f19-4322-b276-82d68b2a138e","type":"text/javascript","packages":{},"requests":{},"exec":[""]}},{"listen":"test","script":{"id":"0d8eca35-7b38-477e-a34f-3252087f3ddb","type":"text/javascript","packages":{},"requests":{},"exec":["assertStatusIs = (status) => {\r","    pm.test(`Status is ${status}`, () => {\r","        pm.response.to.have.status(status);\r","    });\r","};\r","\r","assertResponseContains = (response, options) => {\r","    const { property, type, notNull, notEmpty, expectedValue } = options;\r","\r","    const actual = response[property];\r","\r","    // Type check\r","    if (type !== undefined) {\r","        pm.test(`Property ${property} is of type ${type}`, () => {\r","            pm.expect(typeof actual).to.eql(type);\r","        });\r","    }\r","\r","    // Not null\r","    if (notNull) {\r","        pm.test(`Property ${property} is not null`, () => {\r","            pm.expect(actual).to.not.be.null;\r","        });\r","    }\r","\r","    // Not empty (strings)\r","    if (notEmpty && typeof actual === \"string\") {\r","        pm.test(`Property ${property} is not empty`, () => {\r","            pm.expect(actual).to.not.be.empty;\r","        });\r","    }\r","\r","    // Exact value\r","    if (expectedValue !== undefined) {\r","        pm.test(`Property ${property} equals ${expectedValue}`, () => {\r","            pm.expect(actual).to.eql(expectedValue);\r","        });\r","    }\r","}\r","\r","getRandomProductID = (response) => {\r","    const ids = response.map(p => p.id); // Extract product IDs from the response\r","    do {   \r","        const randomId = ids[Math.floor(Math.random() * ids.length)]; // Select a random product ID - indexes instead of IDs\r","        const product = response.find(p => p.id === randomId); // Find the product with the selected ID\r","        const inStock = product.inStock; // Get the in-stock status of the selected product\r","        if (inStock === true){\r","            return randomId;\r","        }\r","    } while(true);\r","}"]}}],"variable":[{"key":"baseUrl","value":""}]}}